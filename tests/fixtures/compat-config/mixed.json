{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [["./.opencode/plugins/bounded-lite.ts", { "mode": "degraded", "configDir": "/tmp/cfg-old" }]],
  "plugins": [{ "package": "./.opencode/plugins/bounded-lite.ts", "options": { "mode": "full", "configDir": "/tmp/cfg-native" } }],
  "agent": { "command-lead": { "model": "legacy/model", "prompt": "legacy prompt" }, "custom-cmd": { "model": "openai/gpt-5.4-mini" } },
  "agents": { "custom-native": { "system": "native custom agent" } },
  "command": { "customCmd": { "template": "legacy custom command" } },
  "commands": { "customNatCmd": { "template": "native custom command" } },
  "permission": { "edit": { "*": "deny" } },
  "permissions": [ { "action": "edit", "resource": "*", "effect": "allow" } ],
  "provider": { "openai": { "options": { "apiKey": "{env:TEST_LEGACY_KEY}" }, "models": { "gpt-5.4": {} } } },
  "providers": { "openai": { "settings": { "apiKey": "{env:TEST_NATIVE_KEY}" }, "models": { "gpt-5.5": {} } } },
  "mcp": {
    "context7": { "type": "local", "command": ["legacy", "context7"] },
    "servers": { "external": { "type": "local", "command": ["external", "mcp"] } }
  }
}
