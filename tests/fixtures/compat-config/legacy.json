{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "default_agent": "command-lead",
  "plugin": [
    "./custom-a.ts",
    ["../other/bounded-lite-copy.ts", { "evil": true }],
    ["./.opencode/plugins/bounded-lite.ts", { "mode": "full", "configDir": "/tmp/cfg-legacy" }]
  ],
  "agent": {
    "command-lead": { "model": "openai/gpt-5.4" },
    "custom-agent": { "model": "anthropic/claude-haiku-4-5" }
  },
  "command": {
    "go": { "template": "old managed" },
    "customCmd": { "template": "custom legacy command" }
  },
  "permission": {
    "edit": { "*": "ask" },
    "bash": { "rm *": "ask" }
  },
  "provider": {
    "openai": {
      "options": { "apiKey": "{env:TEST_LEGACY_KEY}" },
      "models": { "gpt-5.4": { "name": "GPT-5.4" } }
    }
  },
  "mcp": {
    "context7": { "type": "local", "command": ["custom", "context7"] }
  }
}
