{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [["./.opencode/plugins/bounded-lite.ts", { "mode": "degraded", "configDir": "/tmp/cfg-old" }]],
  "plugins": [{ "package": "./.opencode/plugins/bounded-lite.ts", "options": { "mode": "full", "configDir": "/tmp/cfg-native" } }],
  "agent": { "command-lead": { "model": "legacy/model" } },
  "permissions": [
    { "action": "edit", "resource": "**/package.json", "effect": "allow" },
    { "action": "shell", "resource": "sudo", "effect": "allow" }
  ]
}
